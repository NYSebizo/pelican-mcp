{
  "name": "pelican-mcp",
  "version": "2.0.0",
  "description": "MCP server for Pelican Panel \u2014 full client & application API coverage: everything the panel UI can do",
  "main": "dist/index.js",
  "bin": {
    "pelican-mcp": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist/"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=node --outfile=dist/index.js --external bufferutil --external utf-8-validate",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pelican",
    "pelican-panel",
    "pterodactyl",
    "wings",
    "game-server",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NYSebizo/pelican-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/NYSebizo/pelican-mcp/issues"
  },
  "homepage": "https://github.com/NYSebizo/pelican-mcp#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/ws": "^8.18.2",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  }
}
